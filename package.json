{
  "name": "serein-console",
  "version": "0.1.0",
  "description": "A local terminal workspace for collaborating Codex sessions.",
  "type": "module",
  "private": true,
  "bin": {
    "serein": "./bin/serein.js"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning ./bin/serein.js",
    "setup": "node --disable-warning=ExperimentalWarning ./bin/serein.js setup",
    "test": "node --disable-warning=ExperimentalWarning --test"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1",
    "string-width": "^8.3.0",
    "ws": "^8.22.0"
  }
}
